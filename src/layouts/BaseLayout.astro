---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { HTML_LANG, OG_LOCALE, UI_TEXT, swapLocaleInPath, ensureBase, otherLocale, withBase, type Locale } from "../i18n/config";
import { getSiteMeta, getWork } from "../content";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const siteMeta = getSiteMeta(locale);
const t = UI_TEXT[locale];
const pathname = Astro.url.pathname;
const altLocale = otherLocale(locale);
const workSlug = pathname.match(/\/work\/([^/]+)\/?$/)?.[1];
const hasAlternatePage = workSlug ? Boolean(getWork(altLocale, workSlug)) : true;
const altPath = hasAlternatePage ? swapLocaleInPath(pathname, altLocale) : withBase(`/${altLocale}/`);
const canonicalURL = new URL(ensureBase(pathname), Astro.site);
const altURL = new URL(altPath, Astro.site);
const fullTitle = `${title}${siteMeta.titleSuffix}`;
const ogImage = new URL(withBase(`/og/og-${locale}.png`), Astro.site).href;
const ogImageAlt = locale === "zh" ? "Grant Hsiao 作品集：Product & Design Lead" : "Grant Hsiao portfolio: Product & Design Lead";
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={HTML_LANG[locale]} href={canonicalURL} />
    {hasAlternatePage && <link rel="alternate" hreflang={HTML_LANG[altLocale]} href={altURL} />}
    <link rel="alternate" hreflang="x-default" href={new URL(swapLocaleInPath(pathname, "zh"), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMeta.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {hasAlternatePage && <meta property="og:locale:alternate" content={OG_LOCALE[altLocale]} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href={withBase("/brand/logo.png")} type="image/png" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t.skipToContent}</a>
    <Header locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
