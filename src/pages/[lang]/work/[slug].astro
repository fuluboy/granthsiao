    },
    {
      decision: 3,
      variant: "diagram",
      name: "Prompt Quality",
      purpose: {
        zh: "PROMPT／品質優化 FLOW 從品質漂移診斷到選擇性重跑",
        en: "PROMPT / QUALITY OPTIMIZATION FLOW From Quality-drift Diagnosis to Selective Rerun",
      },
      ratio: "16 / 9",
      display: "contain",
      // decision-03-EN.png is a temporary copy pending the real English asset.
