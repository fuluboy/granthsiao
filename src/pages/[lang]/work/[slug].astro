      purpose: {
        zh: "預生成內容 × Runtime Matching × Daily Signals",
        en: "Pre-generated Content × Runtime Matching × Daily Signals",
      },
      ratio: "16 / 9",
      display: "contain",
      // decision-02-EN.png is a temporary copy pending the real English asset.
      src: localizedSrc("/images/work/star-metric/decision-02.png"),
      width: 1920,
