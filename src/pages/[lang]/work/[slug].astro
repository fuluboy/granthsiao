---
import "../../../styles/case-study.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CaseHero from "../../../components/CaseHero.astro";
import CaseSection from "../../../components/CaseSection.astro";
import SectionNavigation from "../../../components/SectionNavigation.astro";
import SignalGrid from "../../../components/SignalGrid.astro";
import KeyDecision from "../../../components/KeyDecision.astro";
import CaseMetrics from "../../../components/CaseMetrics.astro";
import ImpactGrid from "../../../components/ImpactGrid.astro";
import ReflectionSection from "../../../components/ReflectionSection.astro";
import NextCaseNavigation from "../../../components/NextCaseNavigation.astro";
import Quote from "../../../components/Quote.astro";
import BeforeAfter from "../../../components/BeforeAfter.astro";
import ResponsiveMedia from "../../../components/ResponsiveMedia.astro";
import CaseStudyGallery from "../../../components/CaseStudyGallery.astro";
import CaseStudyLightbox from "../../../components/CaseStudyLightbox.astro";
import CaseInfoCard from "../../../components/CaseInfoCard.astro";
import type { PlaceholderVariant, MediaRatio, MediaDisplay } from "../../../components/MediaPlaceholder.astro";
import { LOCALES, WORK_SLUGS, UI_TEXT, type Locale, type LocalizedText } from "../../../i18n/config";
import { getWork, getHome, workOrder } from "../../../content";
import { localizedSrc, resolveLocalizedSrc, type LocalizedImageSource } from "../../../content/media";

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => WORK_SLUGS.map((slug) => ({ params: { lang, slug } })));
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const caseData = getWork(lang, slug);
const t = UI_TEXT[lang];
const workCards = getHome(lang).selectedWork.cards;
const currentIdx = workOrder.indexOf(slug as (typeof workOrder)[number]);
const prevCard = workCards[(currentIdx - 1 + workCards.length) % workCards.length];
const nextCard = workCards[(currentIdx + 1) % workCards.length];

const sectionNav = t.caseStudy.sectionNav;

const navItems = [
  { id: "context", label: sectionNav.context },
  { id: "what-we-saw", label: sectionNav.whatWeSaw },
  { id: "key-decisions", label: sectionNav.keyDecisions },
  { id: "execution", label: sectionNav.execution },
  { id: "impact", label: sectionNav.impact },
  { id: "reflection", label: sectionNav.reflection },
];

// Presentation descriptors per Key Decision, keyed by case slug.
// Copy (name/purpose) is presentation-only, not case-study content; image
// paths point at the real assets imported into public/images/work/<slug>/.
// ratio/display are explicit per item — deliberately NOT inferred from
// `variant` alone. ResponsiveMedia falls back to the variant default when
// these are omitted, but every real asset here should state its own,
// verified-against-actual-pixel-dimensions shape (see docs/image-specs.md).
//
// src/beforeSrc/afterSrc are LocalizedImageSource ({ zh, en }), built with
// localizedSrc() — never a single shared path — so a page can never load
// the other language's diagram. width/height are one shared value per item
// since the zh/en assets are the same pixel dimensions (same crop, only the
// in-image text differs).
interface DecisionMedia {
  // 1-based Key Decision number this media belongs to — matches the
  // `KEY DECISION N` kicker / KeyDecision `index` prop, NOT the position of
  // this object within the array below. Lookup is by this field (see
  // `decisionMedia.find(...)` below), so entries may be reordered, skipped
  // (a decision with no media yet), or have new decisions inserted between
  // them without any image silently shifting to the wrong decision.
  decision: number;
  variant: PlaceholderVariant;
  name: string;
  purpose: LocalizedText;
  // Only set when this image already has a *visible* on-page caption (see
  // ResponsiveMedia's `caption` prop docs) — do not add one just to fill
  // the field.
  caption?: LocalizedText;
  ratio: MediaRatio;
  display: MediaDisplay;
  src?: LocalizedImageSource;
  beforeSrc?: LocalizedImageSource;
  afterSrc?: LocalizedImageSource;
  width?: number;
  height?: number;
}

