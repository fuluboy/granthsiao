        en: "From personality signals to daily use",
      },
      ratio: "21 / 9",
      display: "contain",
      // decision-01-EN.png is a temporary copy pending the real English asset.
      src: localizedSrc("/images/work/star-metric/decision-01.png"),
      width: 1920,
