      width: 1920,
      height: 1440,
    },
  ],
};

interface CaseImage {
  src: string;
  width: number;
  height: number;
  ratio: MediaRatio;
  display: MediaDisplay;
}

// Hero photos have no in-image text today, so they stay a single shared
// path (CaseImage above) rather than being forced into a { zh, en } pair.
// Execution diagrams do carry embedded text, so they get their own type —
// same LocalizedImageSource/localizedSrc/resolveLocalizedSrc mechanism as
// decisionMediaBySlug, just applied to a different lookup table.
interface LocalizedCaseImage {
  src: LocalizedImageSource;
  width: number;
  height: number;
  ratio: MediaRatio;
  display: MediaDisplay;
}

const heroImageBySlug: Record<string, CaseImage> = {
  house579: { 
    src: "/images/work/house579/hero.jpg", 
    width: 1920, 
    height: 1080, 
    ratio: "16 / 9", 
    display: "cover" 
    },
  "rakuya-data-product": {
    src: "/images/work/rakuya-data-product/hero.jpg",
    width: 1920,
    height: 1080,
    ratio: "16 / 9",
    display: "cover",
  },
  "design-system": {
    src: "/images/work/design-system/hero.jpg",
    width: 1920,
    height: 1080,
    ratio: "16 / 9",
    display: "cover",
  },
    "star-metric": {
    src: "/images/work/star-metric/hero.jpg",
    width: 1920,
    height: 1080,
    ratio: "16 / 9",
    display: "cover",
  },
};

const executionImageBySlug: Record<string, LocalizedCaseImage> = {
  house579: {
    // execution-EN.jpg already existed (pre-dates this change) — localizedSrc's
    // default -EN suffix resolves to it either way, no override needed.
    src: localizedSrc("/images/work/house579/execution.jpg"),
    width: 1920,
    height: 1080,
    ratio: "16 / 9",
    display: "contain",
  },
  "rakuya-data-product": {
    // execution-EN.jpg is a temporary copy pending the real English asset.
    src: localizedSrc("/images/work/rakuya-data-product/execution.jpg"),
    width: 1920,
    height: 1080,
    ratio: "16 / 9",
    display: "contain",
  },
  "star-metric": {
    // execution-EN.png is a temporary copy pending the real English asset.
    src: localizedSrc("/images/work/star-metric/execution.png"),
    width: 1920,
    height: 1080,
    ratio: "16 / 9",
    display: "contain",
  },
  // design-system intentionally has no execution image entry — replaced by
  // the Operating Context / My Role info cards (see caseData.execution
  // .operatingContext / .roleCard) rather than the old "Governance
  // Workflow" screenshot.
};

const decisionMedia = decisionMediaBySlug[slug] ?? [];
const heroImage = heroImageBySlug[slug];
const executionImage = executionImageBySlug[slug];
const executionImageSrc = resolveLocalizedSrc(executionImage?.src, lang);
const impactHighlightMetrics = caseData.metrics.slice(-2);
const operatingContext = caseData.execution.operatingContext;
const roleCard = caseData.execution.roleCard;
const hasExecutionSupport = Boolean(operatingContext && roleCard);
---

<BaseLayout locale={lang} title={caseData.meta.title} description={caseData.meta.description}>
  <div class="case-shell">
    <div class="case-sidebar">
      <SectionNavigation locale={lang} items={navItems} variant="desktop" />
    </div>

    <div class="case-main">
      <CaseHero locale={lang} caseData={caseData} heroImage={heroImage} lightboxGalleryId={heroImage ? `${slug}-hero` : undefined} />

      <SectionNavigation locale={lang} items={navItems} variant="compact" />

      <CaseSection id="context" kicker={caseData.context.kicker} heading={caseData.context.heading}>
    {caseData.context.paragraphs.map((paragraph) => (
      <p class="case-paragraph">{paragraph}</p>
    ))}
    <div class="core-challenge">
      <p class="core-challenge__label">{caseData.context.coreChallengeLabel}</p>
      <Quote text={caseData.context.coreChallengeQuote} size="lg" />
    </div>
  </CaseSection>

  <CaseSection
    id="what-we-saw"
    kicker={caseData.whatWeSaw.kicker}
    heading={caseData.whatWeSaw.heading}
    tone="subtle"
    bodyWidth="wide"
    fullBleed
  >
    <SignalGrid signals={caseData.whatWeSaw.signals} />
  </CaseSection>

  <CaseSection id="key-decisions" kicker={t.caseStudy.keyDecisionsKicker} bodyWidth="none">
    {caseData.keyDecisions.map((decision, i) => {
      const media = decisionMedia.find((m) => m.decision === i + 1);
      const galleryId = `${slug}-decision-${i + 1}`;
      const beforeSrc = resolveLocalizedSrc(media?.beforeSrc, lang);
      const afterSrc = resolveLocalizedSrc(media?.afterSrc, lang);
      const mediaSrc = resolveLocalizedSrc(media?.src, lang);
      return (
        <KeyDecision decision={decision} index={i + 1} hasMedia={Boolean(media)}>
          {media?.variant === "before-after" ? (
            <BeforeAfter
              locale={lang}
              name={media.name}
              caseName={caseData.title}
              purpose={media.purpose[lang]}
              ratio={media.ratio}
              display={media.display}
              beforeSrc={beforeSrc}
              afterSrc={afterSrc}
              width={media.width}
              height={media.height}
              galleryId={beforeSrc && afterSrc ? galleryId : undefined}
            />
          ) : media ? (
            <CaseStudyGallery id={mediaSrc ? galleryId : undefined}>
              <ResponsiveMedia
                locale={lang}
                name={media.name}
                variant={media.variant}
                caseName={caseData.title}
                purpose={media.purpose[lang]}
                ratio={media.ratio}
                display={media.display}
                src={mediaSrc}
                width={media.width}
                height={media.height}
                alt={media.purpose[lang]}
                lightbox={Boolean(mediaSrc)}
                caption={media.caption?.[lang]}
                zoomLabel={t.lightbox.viewLargerImage}
              />
            </CaseStudyGallery>
          ) : null}

          {decision.infoCard && (
            <div slot="sideCard">
              <CaseInfoCard label={decision.infoCard.label}>
                <dl class="governance-cadence">
                  {decision.infoCard.rows.map((row) => (
                    <div class="governance-cadence__row">
                      <dt>{row.label}</dt>
                      <dd>
                        {row.body && <p>{row.body}</p>}
                        {row.items && (
                          <ul>
                            {row.items.map((item) => (
                              <li>{item}</li>
                            ))}
                          </ul>
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              </CaseInfoCard>
            </div>
          )}
        </KeyDecision>
      );
    })}
  </CaseSection>

  <CaseSection
    id="execution"
    kicker={caseData.execution.kicker}
    heading={caseData.execution.heading}
    bodyWidth="none"
  >
    <div class="execution-layout" data-has-support={hasExecutionSupport || undefined}>
      <div class="case-reading execution-layout__content">
        {caseData.execution.paragraphs.map((paragraph) => (
          <p class="case-paragraph">{paragraph}</p>
        ))}

        {caseData.execution.supportingMetrics && (
          <div class="execution-metrics">
            <CaseMetrics
              metrics={caseData.execution.supportingMetrics}
              caption={caseData.execution.supportingMetricsCaption}
              compact
            />
          </div>
        )}
      </div>

      {operatingContext && roleCard && (
        <div class="execution-layout__support">
          <CaseInfoCard label={operatingContext.label}>
            <ul class="operating-context-grid">
              {operatingContext.stats.map((stat) => (
                <li class="operating-context-grid__item">
                  <p class="operating-context-grid__value">{stat.value}</p>
                  <p class="operating-context-grid__label">{stat.label}</p>
                </li>
              ))}
            </ul>
          </CaseInfoCard>

          <CaseInfoCard label={roleCard.label}>
            <ul class="role-card-list">
              {roleCard.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {roleCard.footnote && <p class="role-card-footnote">{roleCard.footnote}</p>}
          </CaseInfoCard>
        </div>
      )}
    </div>

    {executionImageSrc && (
      <div class="case-wide execution-media">
        <CaseStudyGallery id={`${slug}-execution`}>
          <ResponsiveMedia
            locale={lang}
            name={`${caseData.title} — Execution Detail`}
            variant="diagram"
            caseName={caseData.title}
            purpose={t.caseStudy.executionMediaPurpose}
            ratio={executionImage?.ratio}
            display={executionImage?.display}
            src={executionImageSrc}
            width={executionImage?.width}
            height={executionImage?.height}
            alt={t.caseStudy.executionMediaPurpose}
            lightbox={true}
            zoomLabel={t.lightbox.viewLargerImage}
          />
        </CaseStudyGallery>
      </div>
    )}
  </CaseSection>

  <CaseSection
    id="impact"
    kicker={caseData.impact.kicker}
    heading={caseData.impact.heading}
    tone="dark"
    bodyWidth="wide"
    fullBleed
  >
    <ImpactGrid blocks={caseData.impact.blocks} footnote={caseData.impact.footnote} highlightMetrics={impactHighlightMetrics} />
  </CaseSection>

  <CaseSection id="reflection" kicker={caseData.reflection.kicker} heading={caseData.reflection.heading}>
    <ReflectionSection paragraphs={caseData.reflection.paragraphs} />
  </CaseSection>
    </div>
  </div>

  <NextCaseNavigation locale={lang} previous={prevCard} next={nextCard} />
  <CaseStudyLightbox />
</BaseLayout>

<style>
  .case-paragraph {
    color: var(--color-ink-soft);
    font-size: var(--fs-case-body);
  }

  .case-paragraph + .case-paragraph {
    margin-top: var(--space-md);
  }

  .core-challenge {
    margin-top: var(--case-inner-space);
  }

  .core-challenge__label {
    font-size: var(--fs-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
    color: var(--color-ink-soft);
    margin-bottom: var(--space-md);
  }

  .execution-metrics {
    margin-top: var(--case-inner-space);
  }

  .execution-media {
    margin-top: 32px;
  }

  /*
    Plain block by default — identical to the old unwrapped .case-reading
    markup. Only becomes a text/card split when a case actually supplies
    operatingContext + roleCard (currently only design-system), so every
    other case study's Execution section renders exactly as before.
  */
  .execution-layout {
    display: block;
  }

  .execution-layout[data-has-support] {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--case-inner-space);
  }

  .execution-layout__support {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  @media (min-width: 900px) {
    .execution-layout[data-has-support] {
      grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr);
      gap: var(--case-split-gap);
      align-items: start;
    }
  }

  /* ---- Key Decision 3: governance cadence card ---- */
  .governance-cadence {
    display: flex;
    flex-direction: column;
  }

  .governance-cadence__row + .governance-cadence__row {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
  }

  .governance-cadence__row dt {
    font-size: var(--fs-case-meta-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
    color: var(--color-ink-soft);
  }

  .governance-cadence__row dd {
    margin: var(--space-2xs) 0 0;
    font-size: var(--fs-case-caption);
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  .governance-cadence__row dd ul {
    margin: 0;
    padding-left: 1.1em;
  }

  .governance-cadence__row dd li + li {
    margin-top: var(--space-2xs);
  }

  /* ---- Execution: operating context (resource conditions, not KPIs) ---- */
  .operating-context-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm) var(--space-md);
  }

  .operating-context-grid__value {
    font-size: var(--fs-h4);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.1;
  }

  .operating-context-grid__label {
    margin-top: var(--space-2xs);
    font-size: var(--fs-case-caption);
    color: var(--color-ink-soft);
  }

  /* ---- Execution: my role ---- */
  .role-card-list {
    margin: 0;
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .role-card-list li {
    font-size: var(--fs-case-caption);
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  .role-card-footnote {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
