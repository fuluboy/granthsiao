---
// Contact was merged into About (2026-11). Keep the old URLs working.
import { LOCALES, withBase, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
return Astro.redirect(withBase(`/${lang}/about/`));
---
