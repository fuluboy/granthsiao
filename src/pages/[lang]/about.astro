---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Quote from "../../components/Quote.astro";
import { LOCALES, type Locale } from "../../i18n/config";
import { getAbout } from "../../content";
import { siteConfig } from "../../content/siteConfig";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const about = getAbout(lang);
---

<BaseLayout locale={lang} title={about.meta.title} description={about.meta.description}>
  <section class="section">
    <div class="container container-narrow">
      <p class="kicker">{about.kicker}</p>
      <h1 class="about__heading">{about.heading}</h1>

      <div class="about__body">
        {about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="about__quote">
        <Quote text={about.quote} attribution={about.quoteAttribution} size="lg" />
      </div>

      <div class="about__actions">
        <a class="btn" href={`/${lang}/#selected-work`}>{about.profile.primaryAction}</a>
        <a class="btn btn-outline" href={siteConfig.resumeHref[lang]} target="_blank" rel="noopener noreferrer">{about.profile.secondaryAction}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about__heading {
    font-size: var(--fs-h1);
    margin-top: var(--space-sm);
  }

  .about__body {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    font-size: var(--fs-lead);
  }

  .about__quote {
    margin-top: var(--space-2xl);
  }

  .about__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
  }
</style>
