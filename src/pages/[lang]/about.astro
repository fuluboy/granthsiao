---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LOCALES, withBase, type Locale } from "../../i18n/config";
import { getAbout } from "../../content";
import { getArticles } from "../../content/writing";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const about = getAbout(lang);
const latest = getArticles(lang)[0];

const resolveHref = (link: { href: string; external?: boolean }) =>
  link.external ? link.href : withBase(link.href);
---

<BaseLayout locale={lang} title={about.meta.title} description={about.meta.description}>
  <section class="section">
    <div class="container about">
      <header class="about__header">
        <img
          class="about__avatar"
          src={withBase("/images/about/avatar.jpg")}
          alt={about.photoAlt}
          width="72"
          height="72"
          loading="eager"
          decoding="async"
        />
        <div>
          <h1 class="about__name">{about.name}</h1>
          <p class="about__role">{about.role}</p>
        </div>
      </header>

      <p class="about__availability"><span class="about__dot" aria-hidden="true"></span>{about.availability}</p>


      <div class="about__body">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <ul class="about__links">
        {about.links.map((link) => (
          <li>
            <a
              href={resolveHref(link)}
              target={link.external && !link.href.startsWith("mailto:") ? "_blank" : link.external ? undefined : "_blank"}
              rel="noopener noreferrer"
            >{link.label} <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>

      {latest && (
        <a class="about__latest" href={withBase(`/${lang}/writing/${latest.slug}/`)}>
          <span class="about__latest-label">{about.writingLabel}</span>
          <span class="about__latest-title">{latest.frontmatter.title} <span aria-hidden="true">→</span></span>
        </a>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: 640px;
  }

  .about__header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .about__avatar {
    width: 72px;
    height: 72px;
    border-radius: 999px;
    object-fit: cover;
    object-position: center 20%;
    border: 1px solid var(--color-line);
    flex-shrink: 0;
  }

  .about__name {
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
  }

  .about__role {
    margin-top: var(--space-2xs);
    color: var(--color-ink-soft);
  }

  .about__availability {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    padding: var(--space-2xs) var(--space-sm);
    font-size: var(--fs-small);
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
  }

  .about__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #3a9a5b;
  }


  .about__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    line-height: 1.8;
  }

  .about__links {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
  }

  .about__links a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-line-strong);
  }

  .about__links a:hover {
    text-decoration-color: var(--color-ink);
  }

  .about__latest {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-line);
    text-decoration: none;
  }

  .about__latest-label {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }

  .about__latest-title {
    font-weight: 600;
  }

  .about__latest:hover .about__latest-title {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
