---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VinylHero from "../../components/VinylHero.astro";
import SelectedWorkCard from "../../components/SelectedWorkCard.astro";
import SignalGrid from "../../components/SignalGrid.astro";
import { LOCALES, withBase, type Locale } from "../../i18n/config";
import { getHome } from "../../content";
import { siteConfig } from "../../content/siteConfig";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const home = getHome(lang);
const ai = home.aiWorkflow;
---

<BaseLayout locale={lang} title={home.meta.title} description={home.meta.description}>
  <VinylHero home={home} locale={lang} />

  <section class="section selected-work" id="selected-work" aria-labelledby="selected-work-heading">
    <div class="container">
      <h2 id="selected-work-heading" class="kicker">{home.selectedWork.kicker}</h2>
    </div>
    <div class="container">
      {home.selectedWork.cards.map((card) => (
        <SelectedWorkCard locale={lang} card={card} />
      ))}
    </div>
  </section>

  {ai && (
    <section class="section ai-workflow" id="ai-workflow" aria-labelledby="ai-workflow-heading">
      <div class="container">
        <p class="kicker">{ai.kicker}</p>
        <h2 id="ai-workflow-heading" class="ai-workflow__heading">{ai.heading}</h2>
        <p class="ai-workflow__lead">{ai.lead}</p>
        <div class="ai-workflow__steps">
          <SignalGrid signals={ai.steps} />
        </div>
        <p class="ai-workflow__evidence-label">{ai.evidenceLabel}</p>
        <nav class="ai-workflow__evidence" aria-label={ai.evidenceLabel}>
          {ai.evidence.map((item) => (
            <a class="ai-workflow__case" href={withBase(`/${lang}/work/${item.slug}/`)}>
              <span class="ai-workflow__case-name">{item.name}</span>
              <span class="ai-workflow__case-label">{item.label} <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </nav>
      </div>
    </section>
  )}

  <section class="section about-teaser">
    <div class="container container-narrow">
      <p class="kicker">{home.aboutTeaser.kicker}</p>
      <h2 class="about-teaser__heading">{home.aboutTeaser.heading}</h2>
      <p class="about-teaser__paragraph">{home.aboutTeaser.paragraph}</p>
      <a class="btn btn-outline" href={withBase(`/${lang}/about/`)}>{home.aboutTeaser.cta}</a>
    </div>
  </section>

  <section class="section contact-cta bg-dot">
    <div class="container container-narrow contact-cta__inner">
      <p class="kicker">{home.contactCta.kicker}</p>
      <h2 class="contact-cta__title">{home.contactCta.title}</h2>
      <p class="contact-cta__lead">{home.contactCta.lead}</p>
      <a class="btn" href={`mailto:${siteConfig.contactEmail}`}>{home.contactCta.cta}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .selected-work {
    scroll-margin-top: var(--header-height);
  }

  @media (max-width: 767px) {
    .selected-work {
      scroll-margin-top: var(--header-height-mobile);
    }
  }

  .ai-workflow {
    border-top: 1px solid var(--color-line);
  }

  .ai-workflow__heading {
    font-size: var(--fs-h2);
    margin-top: var(--space-sm);
    max-width: 24ch;
    text-wrap: balance;
  }

  :global([data-lang="zh"]) .ai-workflow__heading {
    max-width: none;
  }

  .ai-workflow__lead {
    margin-top: var(--space-md);
    max-width: 62ch;
    color: var(--color-ink-soft);
    font-size: var(--fs-lead);
  }

  .ai-workflow__steps {
    margin-top: var(--space-xl);
  }

  .ai-workflow__evidence-label {
    margin-top: var(--space-xl);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .ai-workflow__evidence {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .ai-workflow__case {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--duration-hover) var(--ease-out);
  }

  .ai-workflow__case:hover,
  .ai-workflow__case:focus-visible {
    border-color: var(--color-ink);
  }

  .ai-workflow__case-name {
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .ai-workflow__case-label {
    font-size: var(--fs-body);
    line-height: 1.5;
  }

  @media (max-width: 767px) {
    .ai-workflow__evidence {
      grid-template-columns: 1fr;
    }
  }

  .about-teaser__heading {
    font-size: var(--fs-h2);
    margin-top: var(--space-sm);
  }

  .about-teaser__paragraph {
    margin-top: var(--space-md);
    color: var(--color-ink-soft);
    font-size: var(--fs-lead);
  }

  .about-teaser .btn {
    margin-top: var(--space-lg);
  }

  .contact-cta__inner {
    text-align: center;
  }

  .contact-cta__title {
    font-size: var(--fs-h1);
    margin-top: var(--space-sm);
  }

  .contact-cta__lead {
    margin-top: var(--space-md);
    color: var(--color-ink-soft);
    font-size: var(--fs-lead);
  }

  .contact-cta .btn {
    margin-top: var(--space-lg);
  }
</style>
