---
import "../../../styles/case-study.css";
import "../../../styles/article.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CaseSection from "../../../components/CaseSection.astro";
import SectionNavigation from "../../../components/SectionNavigation.astro";
import ResponsiveMedia from "../../../components/ResponsiveMedia.astro";
import type { MediaRatio } from "../../../components/MediaPlaceholder.astro";
import CaseStudyGallery from "../../../components/CaseStudyGallery.astro";
import CaseStudyLightbox from "../../../components/CaseStudyLightbox.astro";
import { LOCALES, UI_TEXT, withBase, type Locale } from "../../../i18n/config";
import { getArticles, getArticle, formatArticleDate } from "../../../content/writing";
import { buildArticleSections } from "../../../content/writingRender";
import { getHome } from "../../../content";

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => getArticles(lang).map((a) => ({ params: { lang, slug: a.slug } })));
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const article = getArticle(lang, slug)!;
const t = UI_TEXT[lang];
const tw = t.writing;
const { frontmatter } = article;

const sections = await buildArticleSections(article.module.compiledContent());
const navItems = sections
  .filter((s) => s.heading)
  .map((s) => ({ id: s.id, label: s.navLabel ?? s.heading ?? "" }));

const related = frontmatter.relatedWork
  ? getHome(lang).selectedWork.cards.find((c) => c.slug === frontmatter.relatedWork)
  : undefined;

let figureIndex = 0;
---

<BaseLayout locale={lang} title={frontmatter.title} description={frontmatter.description}>
  <div class="case-shell">
    <div class="case-sidebar">
      <SectionNavigation locale={lang} items={navItems} variant="desktop" />
    </div>

    <div class="case-main">
      <header class="case-reading article-header">
        <a class="article-header__back" href={withBase(`/${lang}/writing/`)}>← {tw.backToWriting}</a>
        <p class="kicker">{tw.kicker}</p>
        <h1 class="article-header__title">{frontmatter.title}</h1>
        <p class="article-header__meta">
          <time datetime={frontmatter.date}>{tw.published} {formatArticleDate(frontmatter.date, lang)}</time>
        </p>
        {frontmatter.figuresNote && <p class="article-header__note">{frontmatter.figuresNote}</p>}
      </header>

      <SectionNavigation locale={lang} items={navItems} variant="compact" />

      {sections.map((section, i) => (
        <CaseSection
          id={section.id}
          kicker={section.heading ? String(i).padStart(2, "0") : undefined}
          heading={section.heading}
          tone={i % 2 === 1 ? "subtle" : "default"}
          fullBleed={i % 2 === 1}
        >
          <div class="article-prose">
            {section.blocks.map((block) =>
              block.type === "html" ? (
                <Fragment set:html={block.html} />
              ) : (
                <figure class="article-figure">
                  <CaseStudyGallery id={`${slug}-figure-${++figureIndex}`}>
                    <ResponsiveMedia
                      locale={lang}
                      name={block.alt}
                      src={block.src}
                      width={block.width}
                      height={block.height}
                      ratio={`${block.width} / ${block.height}` as MediaRatio /* exact image ratio; only used as an aspect-ratio style */}
                      display="contain"
                      alt={block.alt}
                      lightbox
                      caption={block.alt}
                      zoomLabel={t.lightbox.viewLargerImage}
                    />
                  </CaseStudyGallery>
                  <figcaption class="article-figure__caption">{block.alt}</figcaption>
                </figure>
              )
            )}
          </div>
        </CaseSection>
      ))}

      {related && (
        <aside class="case-reading article-related">
          <p class="kicker">{tw.relatedWork}</p>
          <a class="article-related__link" href={withBase(`/${lang}/work/${related.slug}/`)}>
            <span class="article-related__name">{related.name}</span>
            <span class="article-related__title">{related.title}</span>
          </a>
        </aside>
      )}
    </div>
  </div>

  <CaseStudyLightbox />
</BaseLayout>
