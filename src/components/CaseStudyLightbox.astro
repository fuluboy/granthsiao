---
/**
 * Include once per Case Study page (see src/pages/[lang]/work/[slug].astro).
 * Ships the PhotoSwipe init script — dynamically imported, so the ~30kb
 * library only downloads on pages that render this component, and the core
 * PhotoSwipe module itself only loads the moment a visitor actually opens an
 * image. No props: locale is read client-side from <html data-lang> (see
 * BaseLayout.astro) so this component never needs prop-drilling.
 */
import "photoswipe/style.css";
---

<script>
  import "../scripts/case-study-lightbox";
</script>

<style is:global>
  /*
    Skin PhotoSwipe's own CSS custom properties (see
    node_modules/photoswipe/dist/photoswipe.css) with this project's design
    tokens instead of hand-rolling a parallel stylesheet. PhotoSwipe injects
    its DOM at runtime, outside Astro's scoped-style hashing, so this block
    must stay global — kept in this one file rather than scattered so the
    lightbox palette has a single source of truth.
  */
  .pswp {
    --pswp-bg: var(--color-ink);
    --pswp-icon-color: var(--color-paper);
    --pswp-icon-color-secondary: var(--color-ink-soft);
    --pswp-icon-stroke-color: var(--color-ink-soft);
    --pswp-icon-stroke-width: 1px;
    --pswp-placeholder-bg: var(--color-grey-700);
  }

  /* Backdrop opacity must be set via the JS bgOpacity option, not here (see photoswipe.css comment) — this file just documents that it's set in case-study-lightbox.ts. */

  .pswp .pswp__button:hover .pswp__icn {
    fill: var(--color-mustard-strong);
  }

  .pswp .pswp__button:focus-visible {
    outline: 2px solid var(--color-mustard-strong);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .pswp__custom-caption {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    max-width: min(640px, 86vw);
    padding-inline: var(--space-sm);
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--fs-case-caption);
    line-height: 1.5;
    color: var(--color-paper);
    z-index: 10;
    pointer-events: none;
  }

  .pswp__custom-caption--hidden {
    display: none;
  }

  @media (max-width: 767px) {
    .pswp__custom-caption {
      bottom: 20px;
      max-width: 90vw;
    }
  }
</style>
