---
interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
---

<div class="reflection">
  {paragraphs.map((paragraph, i) => (
    <p class:list={["reflection__paragraph", { "reflection__paragraph--lead": i === 0 }]}>{paragraph}</p>
  ))}
</div>

<style>
  .reflection__paragraph {
    font-size: var(--fs-case-body);
    color: var(--color-ink-soft);
  }

  .reflection__paragraph--lead {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.1875rem); /* ~17-19px */
    font-weight: 600;
    color: var(--color-ink);
    line-height: var(--lh-heading);
  }

  :global([data-lang="zh"]) .reflection__paragraph--lead {
    line-height: 1.65;
  }

  .reflection__paragraph + .reflection__paragraph {
    margin-top: var(--space-lg);
  }
</style>
