---
import { UI_TEXT, type Locale } from "../i18n/config";

export type PlaceholderVariant = "hero" | "ui" | "diagram" | "before-after" | "detail" | "process";

/** The only aspect ratios actually produced for this project's media. */
export type MediaRatio = "1 / 1" | "4 / 3" | "16 / 9" | "16 / 10" | "21 / 9";
export type MediaDisplay = "cover" | "contain";

interface Props {
  locale: Locale;
  name: string;
  variant?: PlaceholderVariant;
  caseName?: string;
  purpose?: string;
  format?: string;
  ratio?: MediaRatio;
  display?: MediaDisplay;
  class?: string;
}

interface VariantDefault {
  ratio: MediaRatio;
  display: MediaDisplay;
}

/**
 * Single source of truth for "what a variant looks like by default" — used
 * both here for the placeholder and by ResponsiveMedia.astro for real
 * images, so the two never silently diverge (see VARIANT_DEFAULTS usage
 * there for why that matters).
 */
export const VARIANT_DEFAULTS: Record<PlaceholderVariant, VariantDefault> = {
  hero: { ratio: "16 / 9", display: "cover" },
  ui: { ratio: "4 / 3", display: "contain" },
  diagram: { ratio: "16 / 9", display: "contain" },
  "before-after": { ratio: "16 / 10", display: "contain" },
  detail: { ratio: "1 / 1", display: "contain" },
  process: { ratio: "21 / 9", display: "contain" },
};

const {
  locale,
  name,
  variant = "detail",
  caseName,
  purpose,
  format,
  ratio,
  display,
  class: className,
} = Astro.props;

const t = UI_TEXT[locale];
const resolvedRatio = ratio ?? VARIANT_DEFAULTS[variant].ratio;
const resolvedDisplay = display ?? VARIANT_DEFAULTS[variant].display;
const isPhoto = variant === "hero" || variant === "detail";

const titleParts = [caseName, purpose, format].filter(Boolean);
const titleAttr = titleParts.length > 0 ? titleParts.join(" — ") : undefined;
---

<div
  class:list={["media-placeholder", `media-placeholder--${variant}`, className]}
  style={`aspect-ratio: ${resolvedRatio};`}
  data-display={resolvedDisplay}
  title={titleAttr}
>
  {!isPhoto && <div class="media-placeholder__safe-area" aria-hidden="true"></div>}

  <div class="media-placeholder__inner">
    <p class="media-placeholder__name">{name}</p>
    <p class="media-placeholder__meta">
      {t.media.placeholderVariant[variant]} · {resolvedRatio.replace(" / ", ":")}
    </p>
  </div>
</div>

<style>
  .media-placeholder {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--color-grey-500);
  }

  /* Photo-style variants (hero, detail): faint diagonal stripe, dashed border */
  .media-placeholder--hero,
  .media-placeholder--detail {
    background: repeating-linear-gradient(
      135deg,
      var(--color-grey-100),
      var(--color-grey-100) 14px,
      var(--color-paper-raised) 14px,
      var(--color-paper-raised) 28px
    );
    border: 1.5px dashed var(--color-grey-300);
    border-radius: var(--radius-md);
  }

  /* Technical variants (ui, diagram, before-after, process): flat grid, solid border */
  .media-placeholder--ui,
  .media-placeholder--diagram,
  .media-placeholder--before-after,
  .media-placeholder--process {
    background-color: var(--color-paper-raised);
    background-image: linear-gradient(var(--color-grey-200) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grey-200) 1px, transparent 1px);
    background-size: 24px 24px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
  }

  .media-placeholder__safe-area {
    position: absolute;
    inset: 8%;
    border: 1px dashed var(--color-grey-300);
    pointer-events: none;
  }

  /*
    Text sits directly on the placeholder — no secondary white card, so the
    media area reads as one filled block rather than a big frame around a
    small floating label.
  */
  .media-placeholder__inner {
    position: relative;
    max-width: 82%;
    text-align: center;
  }

  .media-placeholder__name {
    font-weight: 700;
    font-size: var(--fs-case-caption);
    color: var(--color-ink-soft);
  }

  .media-placeholder__meta {
    font-size: var(--fs-case-caption);
    letter-spacing: 0.03em;
    color: var(--color-grey-500);
    margin-top: var(--space-2xs);
  }
</style>
