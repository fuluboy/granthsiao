---
export type PlaceholderVariant = "hero" | "ui" | "diagram" | "before-after" | "detail" | "process";

interface Props {
  name: string;
  variant?: PlaceholderVariant;
  caseName?: string;
  purpose?: string;
  format?: string;
  ratio?: string;
  display?: "cover" | "contain";
  class?: string;
}

const VARIANT_DEFAULTS: Record<PlaceholderVariant, { ratio: string; display: "cover" | "contain" }> = {
  hero: { ratio: "16 / 9", display: "cover" },
  ui: { ratio: "4 / 3", display: "contain" },
  diagram: { ratio: "16 / 9", display: "contain" },
  "before-after": { ratio: "16 / 10", display: "contain" },
  detail: { ratio: "1 / 1", display: "contain" },
  process: { ratio: "21 / 9", display: "contain" },
};

const VARIANT_LABEL: Record<PlaceholderVariant, string> = {
  hero: "Hero",
  ui: "UI",
  diagram: "Diagram",
  "before-after": "Before / After",
  detail: "Detail",
  process: "Process",
};

const ICONS: Record<PlaceholderVariant, string> = {
  hero: `<svg viewBox="0 0 40 40" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="6" width="32" height="28" rx="2" stroke="currentColor" stroke-width="1.6"/><circle cx="14" cy="16" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M4 27L14 19L21 24L28 17L36 26" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  ui: `<svg viewBox="0 0 40 40" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="7" width="32" height="26" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M4 14H36" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="10.5" r="1.1" fill="currentColor"/><circle cx="13" cy="10.5" r="1.1" fill="currentColor"/></svg>`,
  diagram: `<svg viewBox="0 0 40 40" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="17" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="15" y="4" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="27" y="17" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M13 21H15C15 16 15 12 20 12M20 12V12M20 12C25 12 27 16 27 21H27" stroke="currentColor" stroke-width="1.4"/></svg>`,
  "before-after": `<svg viewBox="0 0 40 40" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="8" width="14" height="24" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="22" y="8" width="14" height="24" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M20 6V34" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2.5 2.5"/></svg>`,
  detail: `<svg viewBox="0 0 40 40" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 14V7H13M27 7H34V14M34 26V33H27M13 33H6V26" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="20" cy="20" r="6" stroke="currentColor" stroke-width="1.6"/></svg>`,
  process: `<svg viewBox="0 0 40 40" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="7" cy="20" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="20" cy="20" r="3" stroke="currentColor" stroke-width="1.6"/><circle cx="33" cy="20" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M10 20H17M23 20H30" stroke="currentColor" stroke-width="1.6"/><path d="M27 17L30.5 20L27 23" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
};

const {
  name,
  variant = "detail",
  caseName,
  purpose,
  format,
  ratio,
  display,
  class: className,
} = Astro.props;

const resolvedRatio = ratio ?? VARIANT_DEFAULTS[variant].ratio;
const resolvedDisplay = display ?? VARIANT_DEFAULTS[variant].display;
const isPhoto = variant === "hero" || variant === "detail";

const titleParts = [caseName, purpose, format].filter(Boolean);
const titleAttr = titleParts.length > 0 ? titleParts.join(" — ") : undefined;
---

<div
  class:list={["media-placeholder", `media-placeholder--${variant}`, className]}
  style={`aspect-ratio: ${resolvedRatio};`}
  data-display={resolvedDisplay}
  title={titleAttr}
>
  {!isPhoto && <div class="media-placeholder__safe-area" aria-hidden="true"></div>}

  <div class="media-placeholder__inner">
    <span class="media-placeholder__icon" aria-hidden="true" set:html={ICONS[variant]} />
    <p class="media-placeholder__name">{name}</p>
    <p class="media-placeholder__meta">
      {VARIANT_LABEL[variant]} · {resolvedRatio.replace(" / ", ":")}
    </p>
  </div>
</div>

<style>
  .media-placeholder {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--color-grey-500);
  }

  /* Photo-style variants (hero, detail): diagonal stripe, dashed border */
  .media-placeholder--hero,
  .media-placeholder--detail {
    background: repeating-linear-gradient(
      135deg,
      var(--color-grey-200),
      var(--color-grey-200) 14px,
      var(--color-grey-100) 14px,
      var(--color-grey-100) 28px
    );
    border: 1.5px dashed var(--color-grey-400);
    border-radius: var(--radius-md);
  }

  /* Technical variants (ui, diagram, before-after, process): flat grid, solid border */
  .media-placeholder--ui,
  .media-placeholder--diagram,
  .media-placeholder--before-after,
  .media-placeholder--process {
    background-color: var(--color-grey-100);
    background-image: linear-gradient(var(--color-grey-200) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grey-200) 1px, transparent 1px);
    background-size: 24px 24px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
  }

  .media-placeholder__safe-area {
    position: absolute;
    inset: 8%;
    border: 1px dashed var(--color-grey-300);
    pointer-events: none;
  }

  .media-placeholder__inner {
    position: relative;
    max-width: 82%;
    text-align: center;
    padding: var(--space-sm) var(--space-md);
    background: color-mix(in srgb, var(--color-paper-raised) 90%, transparent);
    border-radius: var(--radius-sm);
  }

  .media-placeholder__icon {
    display: inline-flex;
    color: var(--color-grey-400);
    margin-bottom: var(--space-xs);
  }

  .media-placeholder__icon :global(svg) {
    display: block;
  }

  .media-placeholder__name {
    font-weight: 700;
    font-size: var(--fs-small);
    color: var(--color-ink);
  }

  .media-placeholder__meta {
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--color-grey-500);
    margin-top: var(--space-2xs);
  }
</style>
