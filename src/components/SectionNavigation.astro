---
import { UI_TEXT, type Locale } from "../i18n/config";

interface NavItem {
  id: string;
  label: string;
}

interface Props {
  locale: Locale;
  items: NavItem[];
}

const { locale, items } = Astro.props;
const t = UI_TEXT[locale];
---

<nav class="section-nav" aria-label={t.onThisPage} data-section-nav>
  <p class="section-nav__label">{t.onThisPage}</p>
  <ul class="section-nav__list">
    {items.map((item) => (
      <li>
        <a href={`#${item.id}`} data-section-link={item.id}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>("[data-section-nav]");
  if (nav) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>("[data-section-link]"));
    const sections = links
      .map((link) => document.getElementById(link.dataset.sectionLink ?? ""))
      .filter((el): el is HTMLElement => Boolean(el));

    if (sections.length > 0 && "IntersectionObserver" in window) {
      const setActive = (id: string) => {
        links.forEach((link) => {
          const isActive = link.dataset.sectionLink === id;
          link.classList.toggle("is-active", isActive);
          if (isActive) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0) {
            setActive(visible[0].target.id);
          }
        },
        { rootMargin: "-40% 0px -50% 0px", threshold: 0 }
      );

      sections.forEach((section) => observer.observe(section));
    }
  }
</script>

<style>
  /*
    Default (mobile / tablet, <1280px): sticky top bar directly under the
    site header. Deliberately styled differently from the header nav —
    sunken background strip + pill active state — so the two menus read as
    separate layers.
  */
  .section-nav {
    position: sticky;
    top: var(--header-height-mobile);
    z-index: 40;
    background: var(--color-paper-sunken);
    border-block: 1px solid var(--color-line);
    margin-inline: calc(var(--container-pad) * -1);
    padding-inline: var(--container-pad);
  }

  .section-nav__label {
    display: none;
  }

  .section-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--case-nav-height-mobile);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .section-nav__list::-webkit-scrollbar {
    display: none;
  }

  .section-nav__list a {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--color-ink-soft);
    white-space: nowrap;
    padding: 0.4em 0.95em;
    border-radius: 999px;
    transition: color var(--duration-hover) var(--ease-out),
      background-color var(--duration-hover) var(--ease-out);
  }

  .section-nav__list a:hover,
  .section-nav__list a:focus-visible {
    color: var(--color-ink);
  }

  .section-nav__list a.is-active {
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-mustard-soft) 45%, var(--color-paper-raised));
  }

  @media (min-width: 768px) {
    .section-nav {
      top: var(--header-height);
      margin-inline: 0;
      padding-inline: 0;
    }

    .section-nav__list {
      min-height: var(--case-nav-height);
    }
  }

  /*
    Desktop rail (≥1280px): vertical sidebar in the left grid column,
    sticky under the header. Visual language: hairline + mustard indicator,
    small caps label — nothing like the horizontal header nav.
  */
  @media (min-width: 1280px) {
    .section-nav {
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
      align-self: start;
      z-index: 10;
      background: transparent;
      border-block: none;
      margin-inline: 0;
      padding-inline: 0;
    }

    .section-nav__label {
      display: block;
      font-size: var(--fs-kicker);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: var(--tracking-kicker);
      color: var(--color-grey-500);
      margin-bottom: var(--space-md);
    }

    .section-nav__list {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      min-height: 0;
      overflow: visible;
      border-left: 1px solid var(--color-line);
    }

    .section-nav__list a {
      display: block;
      padding: 0.5em 0 0.5em 1.1em;
      border-radius: 0;
      border-left: 2px solid transparent;
      margin-left: -1.5px;
      white-space: normal;
      line-height: 1.4;
    }

    .section-nav__list a.is-active {
      background: none;
      color: var(--color-ink);
      font-weight: 700;
      border-left-color: var(--color-mustard-strong);
    }
  }
</style>
