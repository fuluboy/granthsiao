---
import type { KeyDecision } from "../content/types";

interface Props {
  decision: KeyDecision;
  index: number;
}

const { decision, index } = Astro.props;
const reversed = index % 2 === 0;
---

<article class="key-decision" id={`key-decision-${index}`}>
  <div class="case-wide">
    <div class:list={["case-split", { "case-split--reverse": reversed }]}>
      <div class="case-split__text key-decision__text">
        <p class="key-decision__number" aria-hidden="true">{String(index).padStart(2, "0")}</p>
        <p class="kicker">{decision.kicker}</p>
        <h3 class="key-decision__heading">{decision.heading}</h3>
        {decision.paragraphs.map((paragraph) => (
          <p class="key-decision__paragraph">{paragraph}</p>
        ))}
      </div>
      <div class="case-split__media key-decision__media">
        <slot />
      </div>
    </div>
  </div>
</article>

<style>
  .key-decision {
    padding-block: var(--space-xl);
  }

  .key-decision + .key-decision {
    border-top: 1px solid var(--color-line);
  }

  .key-decision__number {
    font-size: var(--fs-h1);
    font-weight: 700;
    color: var(--color-grey-300);
    line-height: 1;
  }

  .key-decision__heading {
    font-size: var(--fs-h3);
    margin-top: var(--space-sm);
    max-width: 26ch;
  }

  :global([data-lang="zh"]) .key-decision__heading {
    max-width: none;
    line-height: 1.4;
  }

  .key-decision__paragraph {
    margin-top: var(--space-md);
    font-size: var(--fs-case-body);
    color: var(--color-ink-soft);
  }

  @media (max-width: 599px) {
    .key-decision {
      padding-block: var(--space-lg);
    }

    .key-decision__number {
      font-size: var(--fs-h2);
      color: var(--color-mustard-strong);
    }

    .key-decision__media {
      margin-top: var(--space-md);
    }
  }
</style>
