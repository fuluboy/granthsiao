---
import type { KeyDecision } from "../content/types";

interface Props {
  decision: KeyDecision;
  index: number;
  /** Set false to omit the wide media slot entirely (no empty container left behind) when a decision has no image. */
  hasMedia?: boolean;
}

const { decision, index, hasMedia = true } = Astro.props;
// Named slot, only present when a caller actually passes slot="sideCard" —
// unlike the default slot, this reliably reflects whether that content was
// supplied, so decisions without one keep their original single-column layout.
const hasSideCard = Astro.slots.has("sideCard");
---

<article class="key-decision" id={`key-decision-${index}`}>
  <div class="key-decision__layout" data-has-card={hasSideCard || undefined}>
    <div class="case-reading key-decision__content">
      <div class="key-decision__header">
        <p class="key-decision__number" aria-hidden="true">{String(index).padStart(2, "0")}</p>
        <p class="kicker">{decision.kicker}</p>
      </div>

      <h3 class="key-decision__heading">{decision.heading}</h3>

      <div class="key-decision__body">
        {decision.paragraphs.map((paragraph) => (
          <p class="key-decision__paragraph">{paragraph}</p>
        ))}
      </div>
    </div>

    {hasSideCard && (
      <div class="key-decision__side-card">
        <slot name="sideCard" />
      </div>
    )}
  </div>

  {hasMedia && (
    <div class="case-wide key-decision__media">
      <slot />
    </div>
  )}
</article>

<style>
  .key-decision {
    padding-block: 56px 64px;
  }

  .key-decision + .key-decision {
    border-top: 1px solid var(--color-line);
  }

  .key-decision__number {
    font-size: var(--fs-case-metric-value);
    font-weight: 700;
    color: var(--color-grey-500);
    line-height: 1;
  }

  .key-decision__heading {
    margin-top: 12px;
    font-size: var(--fs-case-decision-title);
    line-height: 1.4;
    max-width: 30em;
  }

  :global([data-lang="zh"]) .key-decision__heading {
    max-width: none;
  }

  .key-decision__body {
    margin-top: 20px;
  }

  .key-decision__paragraph {
    font-size: var(--fs-case-body);
    color: var(--color-ink-soft);
  }

  .key-decision__paragraph + .key-decision__paragraph {
    margin-top: 16px;
  }

  .key-decision__media {
    margin-top: 32px;
  }

  /*
    Plain block by default — identical to the old unwrapped markup. Only
    becomes a text/card split when a decision actually supplies a sideCard
    slot (see design-system's Key Decision 3), so every other decision in
    every other case study renders exactly as before.
  */
  .key-decision__layout {
    display: block;
  }

  .key-decision__layout[data-has-card] {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--case-inner-space);
  }

  .key-decision__side-card {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .key-decision__layout[data-has-card] {
      grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr);
      gap: var(--case-split-gap);
      align-items: start;
    }
  }

  @media (max-width: 767px) {
    .key-decision {
      padding-block: 40px 48px;
    }
  }
</style>
