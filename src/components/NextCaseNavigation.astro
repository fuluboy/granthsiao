---
import { UI_TEXT, type Locale } from "../i18n/config";

interface CaseLink {
  slug: string;
  name: string;
  title: string;
}

interface Props {
  locale: Locale;
  previous: CaseLink;
  next: CaseLink;
}

const { locale, previous, next } = Astro.props;
const t = UI_TEXT[locale];
---

<nav class="case-nav" aria-label={locale === "zh" ? "案例前後導覽" : "Case study navigation"}>
  <div class="case-wide case-nav__grid">
    <a class="case-nav__link case-nav__link--prev" href={`/${locale}/work/${previous.slug}/`}>
      <span class="case-nav__eyebrow">
        <span class="case-nav__arrow" aria-hidden="true">←</span>
        {t.previousCase}
      </span>
      <span class="case-nav__name">{previous.name}</span>
      <span class="case-nav__title">{previous.title}</span>
    </a>
    <a class="case-nav__link case-nav__link--next" href={`/${locale}/work/${next.slug}/`}>
      <span class="case-nav__eyebrow">
        {t.nextCase}
        <span class="case-nav__arrow" aria-hidden="true">→</span>
      </span>
      <span class="case-nav__name">{next.name}</span>
      <span class="case-nav__title">{next.title}</span>
    </a>
  </div>
</nav>

<style>
  .case-nav {
    background: var(--color-paper-raised);
    padding-block: var(--case-section-space);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .case-nav__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
  }

  .case-nav__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    transition: opacity var(--duration-hover) var(--ease-out);
  }

  .case-nav__link:hover,
  .case-nav__link:focus-visible {
    opacity: 0.7;
  }

  .case-nav__link--next {
    text-align: right;
    align-items: flex-end;
  }

  .case-nav__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-mustard);
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
  }

  .case-nav__arrow {
    transition: transform var(--duration-hover) var(--ease-out);
  }

  .case-nav__link--prev:hover .case-nav__arrow,
  .case-nav__link--prev:focus-visible .case-nav__arrow {
    transform: translateX(-4px);
  }

  .case-nav__link--next:hover .case-nav__arrow,
  .case-nav__link--next:focus-visible .case-nav__arrow {
    transform: translateX(4px);
  }

  .case-nav__name {
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
    margin-top: var(--space-sm);
  }

  .case-nav__title {
    font-size: var(--fs-case-h2);
    font-weight: 700;
    max-width: 20ch;
    text-wrap: balance;
  }

  :global([data-lang="zh"]) .case-nav__title {
    max-width: 15em;
    line-height: 1.35;
  }

  @media (max-width: 767px) {
    .case-nav__grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .case-nav__link--next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
