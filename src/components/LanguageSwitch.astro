---
import { UI_TEXT, HTML_LANG, swapLocaleInPath, otherLocale, withBase, type Locale } from "../i18n/config";
import { getWork } from "../content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const target = otherLocale(locale);
const t = UI_TEXT[locale];
const currentPath = Astro.url.pathname;
const workSlug = currentPath.match(/\/work\/([^/]+)\/?$/)?.[1];
const hasTranslatedCase = workSlug ? Boolean(getWork(target, workSlug)) : true;
const altPath = hasTranslatedCase ? swapLocaleInPath(currentPath, target) : withBase(`/${target}/`);
---

<a
  href={altPath}
  class="lang-switch"
  aria-label={t.langSwitchLabelTo(target)}
  hreflang={HTML_LANG[target]}
>
  <img src={withBase("/brand/icon-lang_switch.svg")} alt="" width="20" height="20" aria-hidden="true" />
  <span class="lang-switch__current" aria-current="true">{t.language.current}</span>
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    text-decoration: none;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-sm);
  }

  .lang-switch img {
    width: 18px;
    height: 18px;
    filter: invert(9%);
  }

  .lang-switch__current {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .lang-switch:hover {
    color: var(--color-mustard);
  }

  .lang-switch:hover img {
    filter: invert(38%) sepia(45%) saturate(500%) hue-rotate(360deg);
  }
</style>
