---
import MediaPlaceholder from "./MediaPlaceholder.astro";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  name: string;
  caseName: string;
  purpose: string;
  ratio?: string;
}

const { locale, name, caseName, purpose, ratio = "16 / 10" } = Astro.props;
const beforeLabel = locale === "zh" ? "改版前" : "Before";
const afterLabel = locale === "zh" ? "改版後" : "After";
---

<div class="before-after">
  <figure class="before-after__item">
    <figcaption>{beforeLabel}</figcaption>
    <MediaPlaceholder
      name={`${name} — ${beforeLabel}`}
      variant="before-after"
      caseName={caseName}
      purpose={purpose}
      ratio={ratio}
    />
  </figure>
  <figure class="before-after__item">
    <figcaption>{afterLabel}</figcaption>
    <MediaPlaceholder
      name={`${name} — ${afterLabel}`}
      variant="before-after"
      caseName={caseName}
      purpose={purpose}
      ratio={ratio}
    />
  </figure>
</div>

<style>
  .before-after {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .before-after__item figcaption {
    font-size: var(--fs-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
    color: var(--color-mustard);
    margin-bottom: var(--space-sm);
  }

  @media (max-width: 599px) {
    .before-after {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
