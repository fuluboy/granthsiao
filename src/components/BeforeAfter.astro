---
import ResponsiveMedia from "./ResponsiveMedia.astro";
import CaseStudyGallery from "./CaseStudyGallery.astro";
import { UI_TEXT, type Locale } from "../i18n/config";
import type { MediaRatio, MediaDisplay } from "./MediaPlaceholder.astro";

interface Props {
  locale: Locale;
  name: string;
  caseName: string;
  purpose: string;
  ratio?: MediaRatio;
  display?: MediaDisplay;
  beforeSrc?: string;
  afterSrc?: string;
  width?: number;
  height?: number;
  /** PhotoSwipe gallery id shared by the Before and After slides — see CaseStudyGallery.astro. Omit to render without lightbox (e.g. no real assets yet). */
  galleryId?: string;
}

const {
  locale,
  name,
  caseName,
  purpose,
  ratio = "16 / 10",
  display = "contain",
  beforeSrc,
  afterSrc,
  width,
  height,
  galleryId,
} = Astro.props;
const t = UI_TEXT[locale];
const beforeLabel = t.media.before;
const afterLabel = t.media.after;
const zoomLabel = t.lightbox.viewLargerImage;
const useLightbox = Boolean(galleryId);
---

<CaseStudyGallery id={galleryId}>
  <div class="before-after">
    <figure class="before-after__item">
      <figcaption>{beforeLabel}</figcaption>
      <ResponsiveMedia
        locale={locale}
        name={`${name} — ${beforeLabel}`}
        variant="before-after"
        caseName={caseName}
        purpose={purpose}
        ratio={ratio}
        display={display}
        src={beforeSrc}
        width={width}
        height={height}
        alt={`${purpose} — ${beforeLabel}`}
        lightbox={useLightbox}
        caption={beforeLabel}
        zoomLabel={zoomLabel}
      />
    </figure>
    <figure class="before-after__item">
      <figcaption>{afterLabel}</figcaption>
      <ResponsiveMedia
        locale={locale}
        name={`${name} — ${afterLabel}`}
        variant="before-after"
        caseName={caseName}
        purpose={purpose}
        ratio={ratio}
        display={display}
        src={afterSrc}
        width={width}
        height={height}
        alt={`${purpose} — ${afterLabel}`}
        lightbox={useLightbox}
        caption={afterLabel}
        zoomLabel={zoomLabel}
      />
    </figure>
  </div>
</CaseStudyGallery>

<style>
  .before-after {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .before-after__item figcaption {
    font-size: var(--fs-case-caption);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
    color: var(--color-mustard);
    margin-bottom: var(--space-sm);
  }

  @media (max-width: 599px) {
    .before-after {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
