---
import type { Signal } from "../content/types";

interface Props {
  signals: Signal[];
}

const { signals } = Astro.props;
---

<ul class="insight-rows">
  {signals.map((signal) => (
    <li class="insight-row">
      <p class="insight-row__number" aria-hidden="true">{signal.number.padStart(2, "0")}</p>
      <h3 class="insight-row__heading">{signal.heading}</h3>
      <p class="insight-row__body">{signal.body}</p>
    </li>
  ))}
</ul>

<style>
  .insight-rows {
    border-top: 1px solid var(--color-line);
  }

  .insight-row {
    display: grid;
    grid-template-columns: minmax(2.5rem, 3.25rem) minmax(11.875rem, 14.375rem) minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: baseline;
    padding-block: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem); /* ~20-26px */
    border-bottom: 1px solid var(--color-line);
  }

  .insight-row__number {
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.125rem); /* ~28-34px */
    font-weight: 700;
    color: var(--color-mustard-strong);
    line-height: 1;
  }

  .insight-row__heading {
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.4;
    max-width: 22ch;
  }

  .insight-row__body {
    font-size: var(--fs-case-body);
    color: var(--color-ink-soft);
    max-width: 52ch;
  }

  :global([data-lang="zh"]) .insight-row__heading {
    max-width: none;
    line-height: 1.5;
  }

  :global([data-lang="zh"]) .insight-row__body {
    max-width: none;
  }

  @media (max-width: 1023px) {
    .insight-row {
      grid-template-columns: 3.5rem 1fr;
    }

    .insight-row__body {
      grid-column: 2 / 3;
    }
  }

  @media (max-width: 599px) {
    .insight-row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
      padding-block: var(--space-lg);
    }

    .insight-row__body {
      grid-column: auto;
    }
  }
</style>
