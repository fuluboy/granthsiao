---
interface Props {
  id: string;
  kicker?: string;
  heading?: string;
  tone?: "default" | "subtle" | "tint" | "dark";
  bodyWidth?: "reading" | "wide" | "none";
  fullBleed?: boolean;
}

const { id, kicker, heading, tone = "default", bodyWidth = "reading", fullBleed = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    "case-section",
    `case-section--${tone}`,
    { "case-section--full-bleed": fullBleed },
  ]}
>
  <div class="case-reading case-section__head">
    {kicker && <p class="kicker case-section__kicker">{kicker}</p>}
    {heading && <h2 class="case-section__heading">{heading}</h2>}
  </div>

  {bodyWidth === "none" ? (
    <div class="case-section__body">
      <slot />
    </div>
  ) : (
    <div class:list={[bodyWidth === "wide" ? "case-wide" : "case-reading", "case-section__body"]}>
      <slot />
    </div>
  )}
</section>

<style>
  .case-section {
    position: relative;
    scroll-margin-top: var(--case-anchor-offset-compact);
    padding-block: var(--case-section-space);
    background: var(--section-background, transparent);
  }

  .case-section--default {
    --section-background: var(--color-paper);
  }

  .case-section--subtle {
    --section-background: color-mix(in srgb, var(--color-paper-raised) 55%, var(--color-paper));
  }

  .case-section--tint {
    --section-background: color-mix(in srgb, var(--color-mustard-soft) 12%, var(--color-paper));
  }

  .case-section--dark {
    --section-background: var(--color-ink);
    color: var(--color-paper-raised);
  }

  .case-section--dark .kicker {
    color: var(--color-mustard-strong);
  }

  /*
    Full bleed: the section itself stays in normal flow (no width change,
    no negative margins on the content), a pseudo-element behind it carries
    the background out to the viewport edges. `isolation: isolate` gives
    the section its own stacking context so z-index: -1 on the pseudo
    can't slip behind an earlier sibling section.

    The classic left:50%/translateX(-50%) bleed only lands on the true
    viewport edges when the element's own box is horizontally centered on
    the page. At the >=1100px sidebar breakpoint .case-main is NOT centered
    — it sits to the right of the sidebar+gap — so the naive version
    overshoots by half that offset and creates horizontal scroll.
    --case-bleed-shift corrects for it; it's 0 below the sidebar breakpoint,
    where .case-main has no such offset.
  */
  .case-section--full-bleed {
    isolation: isolate;
    background: none;
    --case-bleed-shift: 0px;
  }

  @media (min-width: 1100px) {
    .case-section--full-bleed {
      --case-bleed-shift: calc((var(--case-sidebar-width) + var(--case-column-gap)) / 2);
    }
  }

  .case-section--full-bleed::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: calc(50% - var(--case-bleed-shift));
    width: 100vw;
    transform: translateX(-50%);
    background: var(--section-background);
  }

  .case-section__kicker {
    margin-bottom: var(--space-md);
  }

  .case-section__heading {
    font-size: var(--fs-case-h2);
    line-height: 1.15;
    max-width: 20ch;
  }

  :global([data-lang="zh"]) .case-section__heading {
    max-width: 18em;
    line-height: 1.3;
  }

  .case-section__body {
    margin-top: var(--case-inner-space);
  }

  @media (min-width: 1100px) {
    .case-section {
      scroll-margin-top: var(--case-anchor-offset-desktop);
    }
  }
</style>
