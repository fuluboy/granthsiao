---
interface Props {
  text: string;
  attribution?: string;
  size?: "md" | "lg";
}

const { text, attribution, size = "md" } = Astro.props;
---

<blockquote class:list={["pull-quote", `pull-quote--${size}`]}>
  <p>“{text}”</p>
  {attribution && <cite>{attribution}</cite>}
</blockquote>

<style>
  .pull-quote {
    margin: 0;
    padding-left: var(--space-lg);
    border-left: 3px solid var(--color-mustard-strong);
  }

  .pull-quote p {
    font-weight: 600;
    line-height: var(--lh-heading);
    text-wrap: pretty;
  }

  :global([data-lang="zh"]) .pull-quote p {
    line-height: 1.65;
  }

  .pull-quote--md p {
    font-size: var(--fs-lead);
  }

  .pull-quote--lg p {
    font-size: var(--fs-h4);
  }

  .pull-quote cite {
    display: block;
    margin-top: var(--space-sm);
    font-style: normal;
    font-size: var(--fs-small);
    color: var(--color-ink-soft);
  }
</style>
