---
import CaseMetrics from "./CaseMetrics.astro";
import ResponsiveMedia from "./ResponsiveMedia.astro";
import type { CaseStudyContent } from "../content/types";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  caseData: CaseStudyContent;
}

const { locale, caseData } = Astro.props;
---

<header class="case-hero">
  <div class="case-wide case-hero__intro">
    <p class="kicker">{caseData.kicker}</p>
    <h1 class="case-hero__title">{caseData.title}</h1>
    <p class="case-hero__lead">{caseData.lead}</p>
  </div>

  <div class="case-wide">
    <dl class="case-hero__facts">
      {caseData.facts.map((fact) => (
        <div class="case-hero__fact">
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="case-wide case-hero__media">
    <ResponsiveMedia
      name={caseData.heroImageName}
      variant="hero"
      caseName={caseData.title}
      purpose={locale === "zh" ? "案例首頁主視覺" : "Case study hero visual"}
      ratio="16 / 9"
      loading="eager"
    />
  </div>

  <div class="case-wide case-hero__metrics">
    <CaseMetrics metrics={caseData.metrics} />
  </div>
</header>

<style>
  .case-hero {
    padding-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .case-hero__intro {
    text-align: left;
  }

  .case-hero__title {
    font-size: var(--fs-case-hero);
    line-height: 1.08;
    max-width: 26ch;
    margin-top: var(--space-sm);
  }

  .case-hero__lead {
    font-size: var(--fs-lead);
    color: var(--color-ink-soft);
    margin-top: var(--space-lg);
    max-width: 56ch;
  }

  /* CJK: em-based measure (1 full-width char ≈ 1em) + denser-glyph line-height */
  :global([data-lang="zh"]) .case-hero__title {
    max-width: 16em;
    line-height: 1.22;
  }

  :global([data-lang="zh"]) .case-hero__lead {
    max-width: 32em;
  }

  .case-hero__facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    margin-top: var(--case-inner-space);
  }

  .case-hero__fact {
    padding-block: var(--space-md);
    padding-inline: var(--space-md);
  }

  .case-hero__fact:first-child {
    padding-inline-start: 0;
  }

  .case-hero__fact + .case-hero__fact {
    border-left: 1px solid var(--color-line);
  }

  .case-hero__fact dt {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-mustard);
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
  }

  .case-hero__fact dd {
    margin: 0;
    margin-top: var(--space-xs);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .case-hero__media {
    margin-top: var(--case-inner-space);
  }

  .case-hero__metrics {
    margin-top: var(--space-xl);
  }

  @media (max-width: 1279px) {
    .case-hero__facts {
      grid-template-columns: repeat(2, 1fr);
      row-gap: var(--space-md);
    }

    .case-hero__fact:nth-child(odd) {
      padding-inline-start: 0;
      border-left: none;
    }

    .case-hero__fact:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
      padding-top: var(--space-md);
    }
  }

  @media (max-width: 599px) {
    .case-hero__facts {
      grid-template-columns: 1fr;
    }

    .case-hero__fact {
      padding-inline-start: 0 !important;
      border-left: none !important;
      border-top: 1px solid var(--color-line);
      padding-top: var(--space-md);
    }

    .case-hero__fact:first-child {
      border-top: none;
      padding-top: 0;
    }
  }
</style>
