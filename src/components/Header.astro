---
import LanguageSwitch from "./LanguageSwitch.astro";
import { UI_TEXT, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = UI_TEXT[locale];
const home = `/${locale}/`;
---

<header class="site-header">
  <div class="site-header__inner container">
    <a href={home} class="site-header__logo" aria-label="Grant Hsiao">
      <img src="/brand/logo.png" alt="Grant Hsiao" width="32" height="40" />
    </a>

    <nav class="site-header__nav" aria-label={locale === "zh" ? "主要導覽" : "Primary navigation"}>
      <ul>
        <li><a href={`${home}about/`}>{t.nav.about}</a></li>
        <li><a href={`${home}#selected-work`}>{t.nav.work}</a></li>
        <li><a href={`${home}contact/`}>{t.nav.contact}</a></li>
      </ul>
      <LanguageSwitch locale={locale} />
    </nav>

    <div class="site-header__mobile-controls">
      <LanguageSwitch locale={locale} />
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
        data-open-label={t.menuOpen}
        data-close-label={t.menuClose}
      >
        <span class="visually-hidden" data-menu-label>{t.menuOpen}</span>
        <span class="menu-toggle__icon" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" data-mobile-nav hidden>
    <ul>
      <li><a href={`${home}about/`}>{t.nav.about}</a></li>
      <li><a href={`${home}#selected-work`}>{t.nav.work}</a></li>
      <li><a href={`${home}contact/`}>{t.nav.contact}</a></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = document.querySelector<HTMLElement>("[data-mobile-nav]");
  const label = toggle?.querySelector<HTMLElement>("[data-menu-label]");

  if (toggle && nav) {
    const openLabel = toggle.dataset.openLabel ?? "";
    const closeLabel = toggle.dataset.closeLabel ?? "";

    const setOpen = (isOpen: boolean) => {
      toggle.setAttribute("aria-expanded", String(isOpen));
      nav.hidden = !isOpen;
      document.body.classList.toggle("nav-open", isOpen);
      if (label) label.textContent = isOpen ? closeLabel : openLabel;
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid transparent;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .site-header__logo img {
    height: 40px;
    width: auto;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--space-lg);
  }

  .site-header__nav a {
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: var(--tracking-kicker);
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--color-mustard);
  }

  .site-header__mobile-controls {
    display: none;
    align-items: center;
    gap: var(--space-md);
  }

  .menu-toggle {
    background: none;
    border: none;
    padding: var(--space-xs);
    cursor: pointer;
  }

  .menu-toggle__icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 22px;
  }

  .menu-toggle__icon span {
    display: block;
    height: 2px;
    background: var(--color-ink);
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 767px) {
    .site-header {
      height: var(--header-height-mobile);
    }

    .site-header__inner {
      height: var(--header-height-mobile);
    }

    .site-header__nav {
      display: none;
    }

    .site-header__mobile-controls {
      display: flex;
    }

    .mobile-nav[hidden] {
      display: none;
    }

    .mobile-nav {
      display: block;
      background: var(--color-paper);
      border-bottom: 1px solid var(--color-line);
      padding: var(--space-md) var(--container-pad);
    }

    .mobile-nav ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }

    .mobile-nav a {
      font-size: var(--fs-lead);
      font-weight: 600;
      text-decoration: none;
    }
  }
</style>
