---
import CaseMetrics from "./CaseMetrics.astro";
import type { ImpactBlock, Metric } from "../content/types";

interface Props {
  blocks: ImpactBlock[];
  footnote?: string;
  highlightMetrics?: Metric[];
}

const { blocks, footnote, highlightMetrics } = Astro.props;
---

<div class="impact">
  <ul class="impact-grid">
    {blocks.map((block) => (
      <li class="impact-block">
        <h3 class="impact-block__heading">{block.heading}</h3>
        <p class="impact-block__body">{block.body}</p>
      </li>
    ))}
  </ul>

  {highlightMetrics && highlightMetrics.length > 0 && (
    <div class="impact-metrics">
      <CaseMetrics metrics={highlightMetrics} tone="dark" compact />
    </div>
  )}

  {footnote && <p class="impact-footnote">{footnote}</p>}
</div>

<style>
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-xl) var(--case-split-gap);
  }

  .impact-block__heading {
    font-size: var(--fs-h4);
    font-weight: 700;
    color: var(--color-mustard-strong);
  }

  .impact-block__body {
    margin-top: var(--space-sm);
    font-size: clamp(0.97rem, 0.93rem + 0.2vw, 1.03rem); /* ~15.5-16.5px */
    line-height: 1.6;
    color: rgba(247, 243, 234, 0.82);
  }

  .impact-metrics {
    margin-top: var(--case-inner-space);
  }

  .impact-footnote {
    margin-top: var(--space-lg);
    font-size: var(--fs-case-caption);
    color: rgba(247, 243, 234, 0.55);
    border-top: 1px solid rgba(247, 243, 234, 0.2);
    padding-top: var(--space-sm);
  }
</style>
