---
import type { Metric } from "../content/types";

interface Props {
  metrics: Metric[];
  caption?: string;
  compact?: boolean;
  tone?: "default" | "dark";
}

const { metrics, caption, compact = false, tone = "default" } = Astro.props;
---

<div class:list={["case-metrics", { "case-metrics--compact": compact, "case-metrics--dark": tone === "dark" }]}>
  {caption && <p class="case-metrics__caption">{caption}</p>}
  <ul class="case-metrics__grid" data-count={Math.min(metrics.length, 4)}>
    {metrics.map((metric) => (
      <li class="case-metrics__item">
        <p class="case-metrics__value">{metric.value}</p>
        <p class="case-metrics__label">{metric.label}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .case-metrics {
    border-top: 1.5px solid var(--color-mustard-strong);
  }

  .case-metrics__caption {
    font-size: var(--fs-small);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-kicker);
    color: var(--color-ink-soft);
    margin-top: var(--space-sm);
  }

  /*
    Column count follows the actual number of metrics — a case with 2
    numbers should not stretch across 4 empty-feeling slots.
  */
  .case-metrics__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .case-metrics__grid[data-count="1"] {
    grid-template-columns: minmax(160px, 320px);
  }

  .case-metrics__grid[data-count="2"] {
    grid-template-columns: repeat(2, minmax(140px, 1fr));
  }

  .case-metrics__grid[data-count="3"] {
    grid-template-columns: repeat(3, minmax(140px, 1fr));
  }

  .case-metrics__grid[data-count="4"] {
    grid-template-columns: repeat(4, minmax(120px, 1fr));
  }

  .case-metrics--compact .case-metrics__grid[data-count="1"] {
    grid-template-columns: minmax(130px, 260px);
  }

  .case-metrics__item {
    padding-block: var(--space-md);
    padding-inline: var(--space-md);
  }

  .case-metrics__item:first-child {
    padding-inline-start: 0;
  }

  .case-metrics__item + .case-metrics__item {
    border-left: 1px solid var(--color-line);
  }

  .case-metrics--dark .case-metrics__item + .case-metrics__item {
    border-left-color: rgba(247, 243, 234, 0.2);
  }

  .case-metrics__value {
    font-size: var(--fs-case-metric-value);
    font-weight: 700;
    line-height: 1.15;
  }

  .case-metrics--dark .case-metrics__value {
    color: var(--color-mustard-strong);
  }

  .case-metrics__label {
    font-size: var(--fs-case-meta-value);
    color: var(--color-ink-soft);
    margin-top: var(--space-2xs);
    line-height: 1.5;
  }

  .case-metrics--dark .case-metrics__label {
    color: rgba(247, 243, 234, 0.72);
  }

  @media (max-width: 767px) {
    .case-metrics__grid:not([data-count="1"]) {
      grid-template-columns: repeat(2, 1fr);
    }

    .case-metrics__item {
      padding-inline: var(--space-sm);
    }

    .case-metrics__item:nth-child(odd) {
      padding-inline-start: 0;
      border-left: none;
    }

    .case-metrics__item:nth-child(even) {
      border-left: 1px solid var(--color-line);
    }

    .case-metrics--dark .case-metrics__item:nth-child(even) {
      border-left-color: rgba(247, 243, 234, 0.2);
    }

    .case-metrics__item:nth-child(n + 3) {
      border-top: 1px solid var(--color-line);
    }

    .case-metrics--dark .case-metrics__item:nth-child(n + 3) {
      border-top-color: rgba(247, 243, 234, 0.2);
    }
  }
</style>
